<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/steam_account_stats_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/steam_widget_surface" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/steam_account_stats_avatar" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/steam_widget_circle" android:src="@drawable/steam_widget_account" android:scaleType="centerCrop" android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginHorizontal="10dp" android:orientation="vertical">
            <TextView android:id="@+id/steam_account_stats_name" android:layout_width="match_parent" android:layout_height="22dp" android:text="@string/steam_widget_account_name_preview" android:textSize="17sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/steam_account_stats_status" android:layout_width="match_parent" android:layout_height="18dp" android:text="@string/steam_widget_account_summary" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/steam_account_stats_configure" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/steam_widget_tune" android:contentDescription="@string/steam_widget_choose_account" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="0dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/steam_widget_stats_start" android:padding="8dp">
            <TextView android:id="@+id/steam_account_stats_playtime" android:layout_width="match_parent" android:layout_height="30dp" android:text="—" android:textSize="20sp" android:textColor="@color/steam_widget_on_primary_container" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
            <TextView android:id="@+id/steam_account_stats_playtime_label" android:layout_width="match_parent" android:layout_height="16dp" android:text="@string/steam_widget_total_playtime" android:textSize="11sp" android:textColor="@color/steam_widget_on_primary_container" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/steam_widget_stats_middle" android:padding="8dp">
            <TextView android:id="@+id/steam_account_stats_inventory" android:layout_width="match_parent" android:layout_height="30dp" android:text="—" android:textSize="20sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
            <TextView android:id="@+id/steam_account_stats_inventory_label" android:layout_width="match_parent" android:layout_height="16dp" android:text="@string/steam_widget_inventory" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="4dp" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/steam_widget_stats_end" android:padding="8dp">
            <TextView android:id="@+id/steam_account_stats_value" android:layout_width="match_parent" android:layout_height="30dp" android:text="—" android:textSize="20sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="22sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
            <TextView android:id="@+id/steam_account_stats_value_label" android:layout_width="match_parent" android:layout_height="16dp" android:text="@string/steam_widget_library_value" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
