<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/steam_recent_games_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/steam_widget_surface" android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/steam_recent_games_avatar" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="@drawable/steam_widget_circle" android:src="@drawable/steam_widget_account" android:scaleType="centerCrop" android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/steam_recent_games_title" android:layout_width="0dp" android:layout_height="28dp" android:text="@string/steam_widget_recent_games" android:textSize="15sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" android:layout_weight="1" />
            <TextView android:id="@+id/steam_recent_games_account" android:layout_width="0dp" android:layout_weight="1" android:layout_height="24dp" android:text="@string/steam_widget_account_name_preview" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:layout_marginStart="8dp" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/steam_recent_games_configure" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:padding="10dp" android:src="@drawable/steam_widget_tune" android:contentDescription="@string/steam_widget_choose_account" />
    </LinearLayout>
    <TextView android:id="@+id/steam_recent_games_empty" android:layout_width="match_parent" android:layout_height="52dp" android:text="@string/steam_widget_tap_configure" android:textSize="13sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="3" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:minHeight="52dp" android:visibility="gone" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" />
    <LinearLayout android:id="@+id/steam_recent_game_row_one" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="4dp" android:padding="8dp" android:background="@drawable/steam_widget_row_surface" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/steam_recent_game_image_one" android:layout_width="88dp" android:layout_height="42dp" android:background="@drawable/steam_widget_image_surface" android:src="@drawable/steam_widget_game" android:scaleType="fitCenter" android:clipToOutline="true" android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/steam_recent_game_name_one" android:layout_width="match_parent" android:layout_height="32dp" android:text="Steam" android:textSize="14sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/steam_recent_game_time_one" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/steam_recent_game_state_one" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/steam_widget_now_playing" android:textSize="10sp" android:textColor="@color/steam_widget_live" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/steam_recent_game_row_two" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="4dp" android:padding="8dp" android:background="@drawable/steam_widget_row_surface" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <ImageView android:id="@+id/steam_recent_game_image_two" android:layout_width="88dp" android:layout_height="42dp" android:background="@drawable/steam_widget_image_surface" android:src="@drawable/steam_widget_game" android:scaleType="fitCenter" android:clipToOutline="true" android:importantForAccessibility="no" android:contentDescription="@null" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/steam_recent_game_name_two" android:layout_width="match_parent" android:layout_height="32dp" android:text="Steam" android:textSize="14sp" android:textColor="@color/steam_widget_on_surface" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="true" android:textStyle="bold" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/steam_recent_game_time_two" android:layout_width="match_parent" android:layout_height="16dp" android:text="" android:textSize="11sp" android:textColor="@color/steam_widget_on_surface_variant" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/steam_recent_game_state_two" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/steam_widget_now_playing" android:textSize="10sp" android:textColor="@color/steam_widget_live" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
